# ============================================================
# Backend environment configuration
# Copy this file to ".env" and fill in real values.
# NEVER commit the real .env file to GitHub.
# ============================================================

# ---- Database ----
# MySQL (recommended for the project). Create the DB first:
#   CREATE DATABASE career_guidance CHARACTER SET utf8mb4;
# Example: mysql+pymysql://root:yourpassword@localhost:3306/career_guidance
DATABASE_URL=mysql+pymysql://root:yourpassword@localhost:3306/career_guidance

# Out-of-the-box demo fallback (no MySQL needed). Uncomment to use:
# DATABASE_URL=sqlite:///./career_guidance.db

# ---- Auth / JWT ----
# Change this to a long random string in production.
SECRET_KEY=change-this-to-a-long-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ---- CORS ----
# Comma-separated list of allowed frontend origins.
# 5173 is the default Vite port; 5174 is used if 5173 is already taken.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173

# ---- App ----
APP_NAME=AI Career Guidance API
ENVIRONMENT=development
